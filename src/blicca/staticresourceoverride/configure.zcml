<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="blicca.staticresourceoverride"
    >

  <include package="plone.resource" file="meta.zcml" />
  <include package="plone.resource" />

  <!-- Server-side template overrides (active via the browser layer) -->
  <include package=".browser" />

  <!-- Static resources: available at
       ++plone++blicca.staticresourceoverride/...  -->
  <plone:static
      type="plone"
      name="blicca.staticresourceoverride"
      directory="static"
      />

  <genericsetup:registerProfile
      name="default"
      title="Blicca Static Resource Override (Training)"
      description="Registers bundles with pattern and Svelte overrides for Blicca (formerly Classic UI)."
      directory="profiles/default"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Blicca Static Resource Override (uninstall)"
      description="Removes the Blicca overrides."
      directory="profiles/uninstall"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_uninstall"
      />

  <!-- 1000 -> 1001: browser layer for the template overrides -->
  <genericsetup:upgradeDepends
      title="Register the browser layer"
      profile="blicca.staticresourceoverride:default"
      source="1000"
      destination="1001"
      import_steps="browserlayer"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="blicca.staticresourceoverride-hiddenprofiles"
      />

</configure>
