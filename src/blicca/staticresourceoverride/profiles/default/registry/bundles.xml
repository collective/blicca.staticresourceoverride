<?xml version="1.0" encoding="utf-8"?>
<registry>

  <!-- The override bundle: a module federation remote which the host
       (Plone bundle/Mockup) initializes on document-ready.
       "depends: plone" makes sure it is loaded after the host. -->
  <records
      interface="plone.base.interfaces.IBundleRegistry"
      prefix="plone.bundles/blicca-staticresourceoverride"
      >
    <value key="enabled">True</value>
    <value key="jscompilation">++plone++blicca.staticresourceoverride/bundles/blicca.staticresourceoverride-remote.min.js</value>
    <value key="csscompilation" />
    <value key="depends">plone</value>
    <value key="load_async">False</value>
    <value key="load_defer">False</value>
  </records>

</registry>
